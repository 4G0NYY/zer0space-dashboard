# zer0space Dashboard — environment variables
#
# IMPORTANT: copy this file to ".env" and fill in real values.
# The .env file is in .gitignore and must NEVER be committed.
# This .env.example file is the template (no real values, committed).
#
# There are NO admin credentials in here. On a fresh database the dashboard
# serves a setup wizard at /setup, where the first administrator is created in
# the browser. The password is hashed with bcrypt the moment it arrives and never
# exists as an environment variable — which is the point: env vars end up in the
# Portainer database, in "docker inspect" output, and in shell history.
# Every account after that is created through an invitation code.
#
# ══════════════════════════════════════════════════════════════════════════════
# SECRETS — Docker Swarm secrets, not variables
# ══════════════════════════════════════════════════════════════════════════════
# Two secrets are read from /run/secrets/ in production. Create them once on a
# manager node:
#
#   printf '%s' 'YOUR-DB-PASSWORD' | docker secret create db_password -
#   openssl rand -hex 32 | tr -d '\n' | docker secret create session_secret -
#
# The lookup order is: secret file → environment variable → (session_secret only)
# a value generated and stored in the database. The env vars below exist for
# LOCAL DEVELOPMENT, where there is no Swarm to hold a secret.

# ── Session & transport security ──────────────────────────────────────────────

# Local-development fallback for the session_secret Swarm secret.
# Generate: openssl rand -hex 32
# Leave unset in production — the secret file takes precedence anyway.
# SESSION_SECRET=

# Set to true only when the dashboard runs behind HTTPS (Cloudflare Tunnel).
# FORCE_HTTPS=true implies this.
COOKIE_SECURE=false

# Redirect plain HTTP requests to HTTPS. Enable together with COOKIE_SECURE
# when the dashboard is publicly reachable through the tunnel.
FORCE_HTTPS=false

# Per-IP rate limiting reads cf-connecting-ip / x-forwarded-for when true, which
# is correct behind the Cloudflare Tunnel. Set to false ONLY when the dashboard
# is exposed directly — there the header is attacker-controlled and trusting it
# would let anyone sidestep the per-IP limits by forging a new address per try.
TRUST_PROXY=true

# ── PostgreSQL — zer0space-postgres, standalone container on zs-state-01 ──────
# Since v3 the dashboard stores users, services, settings and vault entries in
# PostgreSQL instead of a local SQLite file — that is what makes it stateless.
#
# Either set DATABASE_URL as a whole:
# DATABASE_URL=postgres://dashboard:PASSWORD@192.168.0.16:5432/zer0space
#
# ...or the individual values (DATABASE_URL wins if both are set):
DB_HOST=192.168.0.16
DB_PORT=5432
DB_NAME=zer0space
DB_USER=dashboard

# NO DB_PASS here. In production the password comes from the db_password Swarm
# secret. For local development against a throwaway Postgres, set it in your
# own .env — never in this template:
# DB_PASS=

# The tables are created automatically on first start (CREATE TABLE IF NOT EXISTS).
# Migrating an existing SQLite DB:
#   node scripts/migrate-sqlite-to-pg.js --sqlite /mnt/storage/dashboard/services.db

# ── Host metrics (Glances) ────────────────────────────────────────────────────
# Swarm service name of the global Glances service and the port it serves its
# REST API on. The backend resolves each node's LAN IP from the Swarm API and
# queries http://<node-ip>:<GLANCES_PORT>.
GLANCES_SERVICE=dashboard_glances
GLANCES_PORT=61208

# ── Standalone hosts (not Swarm members) ──────────────────────────────────────
# Machines that run Glances but sit outside the cluster on purpose, so they never
# show up in the Docker API's /nodes. Without this they go unmonitored — which is
# backwards, given that the database and the shared storage are the two hosts
# whose failure takes everything else with them.
#
# Format: name:ip[:label]   (comma-separated)
#   name  — shown on the card
#   ip    — Glances must answer on GLANCES_PORT here
#   label — optional free-text badge, e.g. Stateful / Storage
#
# Rendered in their own "Standalone-Hosts" section with a separate count, so the
# "nodes online X/Y" tile keeps describing the Swarm and nothing else.
# Leave empty to hide the section entirely.
EXTRA_HOSTS=zs-state-01:192.168.0.16:Stateful,zs-store-01:192.168.0.15:Storage

# ── Docker socket proxy ───────────────────────────────────────────────────────
# Read-only Docker API proxy used for the Swarm/cluster status cards.
DOCKER_PROXY_URL=http://socketproxy:2375

# ── Paths (optional — defaults match the docker-compose volume) ───────────────
# Root of the persistent data directory inside the container. Holds the uploaded
# background images and the per-node backup status files.
# DATA_DIR=/data
# Directory the backup script drops its per-node <hostname>.json into.
# BACKUP_STATUS_DIR=/data/backup-status

# ── Misc ──────────────────────────────────────────────────────────────────────
TZ=Europe/Zurich
