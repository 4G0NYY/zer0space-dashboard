# zer0space Dashboard — environment variables
#
# IMPORTANT: copy this file to ".env" and fill in real values.
# The .env file is in .gitignore and must NEVER be committed.
# This .env.example file is the template (no real values, committed).
#
# ══════════════════════════════════════════════════════════════════════════════
# RECOMMENDED: Docker Swarm secrets (more secure than env vars)
# ══════════════════════════════════════════════════════════════════════════════
# Run once on a manager node:
#
#   1. Generate a password hash (the plaintext password stays ONLY in your head /
#      password manager):
#      docker run --rm ghcr.io/zer0space-net/zer0space-dashboard:latest \
#        node -e "console.log(require('bcryptjs').hashSync('YOUR-PASSWORD', 12))"
#
#   2. Store the hash as a Swarm secret:
#      printf '%s' '$2b$12$...' | docker secret create dashboard_hash -
#
#   3. Generate and store a session secret:
#      openssl rand -hex 32 | docker secret create session_secret -
#
#   After that: keep the "secrets:" section in docker-compose.yml uncommented.
#   The variables below are then NOT needed.
#
# ══════════════════════════════════════════════════════════════════════════════
# ALTERNATIVE: Portainer "Environment variables"
# (simpler, but env vars are stored in the Portainer DB)
# ══════════════════════════════════════════════════════════════════════════════
# Set these values in Portainer → Stack → "Environment variables".
# Comment out the "secrets:" sections in docker-compose.yml.

# ── Admin account ─────────────────────────────────────────────────────────────

# Admin username (not a secret, only used on first start of an empty DB)
DASHBOARD_USER=admin

# Password for first start — choose ONE path:
#
# Path 1 — Simple (plaintext, hashed once at first start, ignored after that):
DASHBOARD_PASS=CHANGE-ME
#
# Path 2 — Secure (pre-computed bcrypt hash, recommended for production / Swarm
# secrets). Generate the hash once, locally:
#   docker run --rm ghcr.io/zer0space-net/zer0space-dashboard:latest \
#     node -e "console.log(require('bcryptjs').hashSync('YOUR-PASSWORD', 12))"
# DASHBOARD_HASH=$2b$12$PASTE_THE_GENERATED_HASH_HERE

# ── Session & transport security ──────────────────────────────────────────────

# Random 64-character hex string for session signing.
# Generate: openssl rand -hex 32
# Auto-generated and stored in the DB if not set — set it explicitly for production.
SESSION_SECRET=PASTE_OPENSSL_RAND_HEX_32_OUTPUT_HERE

# Set to true only when the dashboard runs behind HTTPS (Cloudflare Tunnel)
COOKIE_SECURE=false

# Redirect plain HTTP requests to HTTPS. Enable together with COOKIE_SECURE
# when the dashboard is publicly reachable through the tunnel.
FORCE_HTTPS=false

# ── PostgreSQL — zer0space-postgres, standalone container on zs-state-01 ──────
# Since v3 the dashboard stores users, services, settings and vault entries in
# PostgreSQL instead of a local SQLite file — that is what makes it stateless.
#
# Either set DATABASE_URL as a whole:
# DATABASE_URL=postgres://dashboard:PASSWORD@192.168.0.16:5432/zer0space
#
# ...or the individual values (DATABASE_URL wins if both are set):
DB_HOST=192.168.0.16
DB_PORT=5432
DB_NAME=zer0space
DB_USER=dashboard
DB_PASS=CHANGE-ME

# Preferred for production — store the password as a Swarm secret instead of an
# env var, then leave DB_PASS empty:
#   printf '%s' 'YOUR-DB-PASSWORD' | docker secret create db_password -
# The server reads /run/secrets/db_password first and only falls back to DB_PASS.
#
# The tables are created automatically on first start (CREATE TABLE IF NOT EXISTS).
# Migrating an existing SQLite DB:
#   node scripts/migrate-sqlite-to-pg.js --sqlite /mnt/storage/dashboard/services.db

# ── Host metrics (Glances) ────────────────────────────────────────────────────
# Swarm service name of the global Glances service and the port it serves its
# REST API on. The backend resolves each node's LAN IP from the Swarm API and
# queries http://<node-ip>:<GLANCES_PORT>.
GLANCES_SERVICE=dashboard_glances
GLANCES_PORT=61208

# ── Docker socket proxy ───────────────────────────────────────────────────────
# Read-only Docker API proxy used for the Swarm/cluster status cards.
DOCKER_PROXY_URL=http://socketproxy:2375

# ── Paths (optional — defaults match the docker-compose volume) ───────────────
# Root of the persistent data directory inside the container. Holds the uploaded
# background images and the per-node backup status files.
# DATA_DIR=/data
# Directory the backup script drops its per-node <hostname>.json into.
# BACKUP_STATUS_DIR=/data/backup-status

# ── Misc ──────────────────────────────────────────────────────────────────────
TZ=Europe/Zurich
