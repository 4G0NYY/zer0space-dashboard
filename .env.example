# zer0space Dashboard — environment variables
#
# IMPORTANT: copy this file to ".env" and fill in real values. The .env file is
# in .gitignore and must NEVER be committed. This template contains no real
# values and never should.
#
# There are NO admin credentials in here. On a fresh database the dashboard
# serves a setup wizard at /setup where the first administrator is created in the
# browser. The password is hashed with bcrypt the moment it arrives and never
# exists as an environment variable — which is the point: env vars end up in the
# Portainer database, in `docker inspect` output, and in shell history. Every
# account after that is created by redeeming an invitation code.
#
# ══════════════════════════════════════════════════════════════════════════════
# SECRETS — Docker Swarm secrets, not variables
# ══════════════════════════════════════════════════════════════════════════════
# Four secrets are read from /run/secrets/ in production. Create them once on a
# manager node:
#
#   printf '%s' 'YOUR-DB-PASSWORD' | docker secret create db_password -
#   openssl rand -hex 32 | tr -d '\n' | docker secret create session_secret -
#   openssl rand -hex 32 | tr -d '\n' | docker secret create totp_enc_key -
#   openssl rand -hex 32 | tr -d '\n' | docker secret create crimson_sso_secret -
#
# The lookup order in src/config.py is: secret file → environment variable →
# (session_secret and totp_enc_key only) a value generated and stored in the
# settings table. The variables below exist for LOCAL DEVELOPMENT, where there
# is no Swarm.

# ── PostgreSQL — standalone container on zs-state-01 ──────────────────────────
# The dashboard holds no database state of its own; users, services, settings and
# vault entries all live here, which is what makes it schedulable on any node.
#
# Either set DATABASE_URL as a whole:
# DATABASE_URL=postgres://dashboard:PASSWORD@192.168.0.16:5432/zer0space
#
# ...or the individual values (DATABASE_URL wins if both are set):
DB_HOST=192.168.0.16
DB_PORT=5432
DB_NAME=zer0space
DB_USER=dashboard

# NO DB_PASS here. In production it comes from the db_password Swarm secret. For
# local development against a throwaway Postgres, set it in your own .env:
# DB_PASS=

# Tables are created on first start (CREATE TABLE IF NOT EXISTS) and later
# columns are added with ALTER TABLE ... ADD COLUMN IF NOT EXISTS. There is no
# migration framework; see src/db.py.

# ── Session & transport security ──────────────────────────────────────────────

# Local-development fallback for the session_secret Swarm secret.
# Generate: openssl rand -hex 32
# SESSION_SECRET=

# Session lifetime in seconds. This is also how long a stolen session cookie can
# decrypt the vault, since the derived vault key lives in the session.
SESSION_MAX_AGE=86400

# Local-development fallback for the totp_enc_key Swarm secret. Encrypts each
# user's TOTP secret at rest — a separate key from SESSION_SECRET on purpose, so
# rotating one never silently invalidates the other.
# Generate: openssl rand -hex 32
# TOTP_ENC_KEY=

# true enables HSTS and upgrade-insecure-requests. Leave false for plain HTTP on
# the LAN: once a browser stores an HSTS entry it upgrades every later request,
# and http://node:8080 stops working until it expires.
FORCE_HTTPS=false

# Marks the session cookie Secure, independently of the HSTS flag above. Default
# is now true. The session holds the derived vault key for SESSION_MAX_AGE, so
# whoever captures this cookie can read every stored credential, not merely act
# as the user. Only set false if you serve the dashboard over plain HTTP and
# accept that the cookie crosses the network in the clear.
COOKIE_SECURE=true

# Per-IP rate limiting reads cf-connecting-ip / x-forwarded-for when true, which
# is correct behind the Cloudflare Tunnel. Set to false ONLY when the dashboard
# is exposed directly — there the header is attacker-controlled and trusting it
# would let anyone sidestep the per-IP limits by forging a new address per try.
TRUST_PROXY=true

# Which peers may speak for another address via those headers. TRUST_PROXY alone
# says "read the header", not "and only from the tunnel". Empty keeps the old
# trust-everyone behaviour. Set it to the tunnel's overlay subnet ONLY:
#   docker network inspect cloudflared_proxy -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# 10.0.0.0/8 is too broad — it also covers the ingress gateway that LAN traffic
# to a published port arrives from.
TRUSTED_PROXY_IPS=

# Read by uvicorn itself, not by src/config.py. The image no longer starts with
# --forwarded-allow-ips '*', which had let any peer overwrite request.client.host
# through X-Forwarded-For and quietly defeated TRUST_PROXY=false. Unset means
# uvicorn's own 127.0.0.1 default.
FORWARDED_ALLOW_IPS=

# Comma-separated Host header allow list. Empty disables the check. Set it in
# production so a forged Host cannot reach request handling at all.
# ALLOWED_HOSTS=dash.example.com

# The dashboard's real public address. When set it is the source of truth for the
# X-Forwarded-Proto / X-Forwarded-Host that the Crimson gateway sends its
# backend, which otherwise come from the client's own Host header and steer the
# absolute stream URLs the backend hands the player.
# PUBLIC_BASE_URL=https://dash.example.com

# ── Host metrics (Glances) ────────────────────────────────────────────────────
# Swarm service name of the global Glances service and the port it serves its
# REST API on. The backend resolves each node's LAN IP from the Swarm API and
# queries http://<node-ip>:<GLANCES_PORT>/api/4/...
GLANCES_SERVICE=dashboard_glances
GLANCES_PORT=61208
METRICS_TIMEOUT=4.0

# ── Docker socket proxy ───────────────────────────────────────────────────────
# Read-only Docker API proxy used for the Swarm/cluster status tiles.
DOCKER_PROXY_URL=http://socketproxy:2375

# ── Standalone hosts (not Swarm members) ──────────────────────────────────────
# Machines that run Glances but sit outside the cluster on purpose, so they never
# show up in the Docker API's /nodes. Without this they go unmonitored — which is
# backwards, given that the database and the shared storage are the two hosts
# whose failure takes everything else with them.
#
# Format: name:ip[:label]   (comma-separated)
#   name  — shown on the card
#   ip    — Glances must answer on GLANCES_PORT here
#   label — optional free-text badge, e.g. Stateful / Storage
#
# Rendered in their own "Standalone hosts" section with a separate count, so the
# "Nodes online X/Y" tile keeps describing the Swarm and nothing else.
# Leave empty to hide the section entirely.
EXTRA_HOSTS=zs-state-01:192.168.0.16:Stateful,zs-store-01:192.168.0.15:Storage

# ── Paths (defaults match the docker-compose volume) ──────────────────────────
# Root of the persistent data directory inside the container. Holds uploaded
# background images and the per-node backup status files.
# DATA_DIR=/data
# Directory the backup script drops its per-node <hostname>.json into.
# BACKUP_STATUS_DIR=/data/backup-status
# A backup older than this counts as stale on the tile.
BACKUP_STALE_HOURS=26

# ── Application ───────────────────────────────────────────────────────────────
PORT=3000
TZ=Europe/Zurich

# Serves templates/maintenance.html for every request except /healthz and
# /static/*. An env flag rather than a DB setting on purpose: the situation you
# need it for is "the database is unreachable".
MAINTENANCE_MODE=false

GITHUB_URL=https://github.com/zer0space-net
STATUS_URL=https://status.zer0space.com

# ── zer0space ✕ Crimson gateway ───────────────────────────────────────────────
# When BOTH are set, the dashboard serves the Crimson Haven frontend
# (github.com/crimsonhaven-to) at /crimson, gated on the zer0space session and
# reverse-proxied: the SPA to CRIMSON_CLIENT_URL and its /crimson/api calls to
# CRIMSON_API_URL. Leave either blank and /crimson 404s (feature off).
# Point these at the in-cluster service names over the overlay network.
# CRIMSON_CLIENT_URL=http://zer0space-crimson-client:80
# CRIMSON_API_URL=http://zer0space-crimson-api:8000
# Header the backend may trust as the gateway-authenticated zer0space user id
# (for the SSO bridge). Sent only to the API upstream.
# CRIMSON_USER_HEADER=X-Zer0space-User
#
# SSO broker: give each zer0space user a real, synced Crimson account with no
# login screen. When the secret AND an invite code are set, the dashboard derives
# a deterministic Ed25519 key per user, registers/logs the account in on the
# backend, and injects the Bearer. Prefer the crimson_sso_secret Swarm secret
# over this env var. The invite code must be one the backend's SIGNUP_INVITE_CODE
# accepts. Unset → /crimson works but without per-user favourites/progress.
# CRIMSON_SSO_SECRET=generate-with-openssl-rand-hex-32
# CRIMSON_SSO_INVITE_CODE=the-backends-signup-invite-code

# ── AI assistant ──────────────────────────────────────────────────────────────
# The assistant lives in a separate service (github.com/zer0space-net/zer0space-ai)
# that this dashboard gates and proxies at /api/ai/*. Only the ADDRESS belongs
# here. Provider, model, API keys, system prompt and context toggles are stored
# in PostgreSQL and edited in the dashboard under Settings > AI, so switching
# model is a dropdown rather than a stack redeploy. Do not add an AI_MODEL or an
# ANTHROPIC_API_KEY variable: if a setting is product configuration, it belongs
# in the database.
#
# Blank turns the feature off entirely: the chat panel hides itself, the AI
# settings tab disappears and /api/ai/* answers 503.
AI_SERVICE_URL=http://ai:8000

# Shared token the dashboard presents to the AI service. Prefer the
# ai_service_token Swarm secret over this variable. If neither exists, both
# services fall back to a value generated once and stored in the settings table,
# which they both read, so a first deploy needs no setup at all.
# AI_SERVICE_TOKEN=generate-with-openssl-rand-hex-32
