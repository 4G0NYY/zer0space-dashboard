# The image is built and run on Linux — keep LF in the working tree on every
# platform so nothing ends up with CRLF inside the container.
* text=auto eol=lf

# Binary / generated
*.png binary
*.jpg binary
*.webp binary
# Vendored icon webfont — must never be touched by eol normalisation.
*.woff2 binary
*.woff binary
*.ttf binary
# The vendored Tabler CSS is generated, not hand-written — keep it out of diffs.
static/vendor/** linguist-vendored
package-lock.json -diff linguist-generated
